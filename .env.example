# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sleeper ----
# No auth. Just your username.
# Fixture recorder and smoke script only — never a sync connection.
SLEEPER_USERNAME=

# ---- Yahoo (deferred final provider milestone) ----
# Do not configure for current work. Fantasy access requires reviewed approval:
# https://sports.yahoo.com/developer/access/
# Access is read-only by default; request Read/Write in Additional Notes.
# After approval, the redirect URI must match exactly.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/yahoo/callback
# Base64-encoded 32-byte key used only to encrypt provider refresh tokens.
# Generate outside source control, for example: openssl rand -base64 32
PLATFORM_TOKEN_ENCRYPTION_KEY=

# ---- ESPN (future connector) ----
# Users sign in on ESPN itself. Slate must never request or store an ESPN
# password, cookie, session header, or copied credential in this file.

# ---- App ----
# Guards /api/cron/sync. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Current NFL season. Sleeper's /state/nfl is authoritative at runtime;
# this is only a fallback for scripts.
DEFAULT_SEASON=2026
