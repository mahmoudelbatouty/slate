# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sleeper ----
# No auth. Just your username.
SLEEPER_USERNAME=

# ---- Yahoo (M3) ----
# Register at https://developer.yahoo.com/apps/
# Permissions: Fantasy Sports -> Read only
# Redirect URI must match exactly, including trailing slash rules.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/yahoo/callback
# Base64-encoded 32-byte key used only to encrypt provider refresh tokens.
# Generate outside source control, for example: openssl rand -base64 32
PLATFORM_TOKEN_ENCRYPTION_KEY=

# ---- ESPN (M4) ----
# Not set here. Pasted at /admin/connections and stored in
# platform_accounts.secrets, because these rotate and you'll
# re-paste them mid-season more than once.

# ---- App ----
# Single-user gate. Any long random string.
APP_PASSWORD=
# Guards /api/cron/sync. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Current NFL season. Sleeper's /state/nfl is authoritative at runtime;
# this is only a fallback for scripts.
DEFAULT_SEASON=2026
